# ═══════════════════════════════════════════════════════════
# Variables de Entorno para Docker - Arma Multiclan Platform
# ═══════════════════════════════════════════════════════════
#
# Copia este archivo a .env y configura los valores:
#   cp .env.example .env
#
# ═══════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────
# BASE DE DATOS
# ─────────────────────────────────────────────────────────
POSTGRES_USER=arma_user
POSTGRES_PASSWORD=cambia_esta_contraseña_segura
POSTGRES_DB=arma_platform
POSTGRES_PORT=5432

# ─────────────────────────────────────────────────────────
# BACKEND
# ─────────────────────────────────────────────────────────
NODE_ENV=production
BACKEND_PORT=3000

# IMPORTANTE: Genera un secreto seguro con: openssl rand -base64 32
JWT_SECRET=CAMBIA_ESTO_genera_un_secreto_seguro_de_al_menos_32_caracteres
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────
# FRONTEND
# ─────────────────────────────────────────────────────────
FRONTEND_HTTP_PORT=8080
FRONTEND_PORT=8000

# URL del API: ruta relativa via reverse proxy de nginx (RECOMENDADO)
# Nginx reenvía /api/* al backend internamente.
# Esto permite acceder desde cualquier IP/dominio sin problemas de CORS.
VITE_API_URL=/api

# URL base pública del frontend para CORS y redirecciones OAuth en el backend.
# Para HTTPS, usa el esquema https://. Si el puerto HTTPS no es 443, déjalo
# sin puerto aquí y usa FRONTEND_PORT para que backend y Docker lo añadan.
# Ejemplos:
#   https://midominio.com
#   https://midominio.com:8000
#   https://192.168.1.20:8000
FRONTEND_URL=https://localhost

# Rutas del host a los archivos PEM del certificado TLS que montará Nginx.
TLS_CERT_PATH=./docker/certs/frontend-selfsigned.crt
TLS_KEY_PATH=./docker/certs/frontend-selfsigned.key

# ─────────────────────────────────────────────────────────
# CORS - Orígenes Adicionales (OPCIONAL)
# ─────────────────────────────────────────────────────────
# Orígenes extra separados por comas para permitir acceso directo al backend.
# Útil para IPs de LAN cuando los clientes no pasan por el reverse proxy.
# Ejemplo: http://192.168.1.20:45375,http://10.0.0.5:45375
CORS_EXTRA_ORIGINS=

# ─────────────────────────────────────────────────────────
# DISCORD OAUTH2 (OPCIONAL)
# ─────────────────────────────────────────────────────────
# Obtén estos valores en https://discord.com/developers/applications
# IMPORTANTE: DISCORD_REDIRECT_URI debe coincidir EXACTAMENTE (carácter a carácter)
# con la registrada en Discord, incluyendo el puerto si no es el 80.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://localhost:8000/api/auth/discord/callback

# ─────────────────────────────────────────────────────────
# COOKIES (Seguridad)
# ─────────────────────────────────────────────────────────
# COOKIE_SECURE=true  → Solo enviar cookies por HTTPS
# COOKIE_SECURE=false → Permitir cookies por HTTP
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ─────────────────────────────────────────────────────────
# PASSWORD RESET / SMTP (OPCIONAL)
# ─────────────────────────────────────────────────────────
# URL del frontend donde el usuario completará el reset.
# Si se omite, se usa FRONTEND_URL + /reset-password
PASSWORD_RESET_URL=https://localhost:8000/reset-password
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Preparado para futuro SMTP. En el despliegue actual, si faltan estos
# valores, la plataforma generará el token pero no podrá entregar el email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=no-reply@example.com
SMTP_USER=
SMTP_PASS=

ADMIN_EMAIL=admin@arma.com
ADMIN_PASSWORD=Admin123!
ADMIN_NICKNAME=Admin
