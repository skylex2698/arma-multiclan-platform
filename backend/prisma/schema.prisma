generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== ENUMS =====

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
  BANNED
  INACTIVE
  EXTERNAL
}

enum UserRole {
  USER
  OPERATIONS_OFFICER
  RECRUITER
  CLAN_LEADER
  ADMIN
}

enum ClanCreationRequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

enum EventStatus {
  ACTIVE
  INACTIVE
  FINISHED
}

enum EventVisibility {
  PUBLIC
  PRIVATE
}

enum SlotStatus {
  FREE
  OCCUPIED
}

enum GameStatus {
  ACTIVE
  INACTIVE
}

enum GameIdentityMode {
  STEAM64
  MANUAL
  NONE
}

enum GameIdentityProviderKind {
  STEAM
  MANUAL
  NONE
}

enum GameIdentityStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT_JUSTIFIED
  NO_SHOW
}

enum NotionSyncMode {
  MANUAL
  AUTO
}

enum FeedbackType {
  BUG
  SUGGESTION
}

enum FeedbackStatus {
  OPEN
  IN_REVIEW
  DONE
  REJECTED
}

// ===== MODELOS =====

model User {
  id                String      @id @default(uuid())
  email             String?     @unique
  password          String?
  nickname          String
  timezone          String      @default("Europe/Madrid")
  mustCreateClanOnboarding Boolean @default(false)
  discordId         String?     @unique
  discordUsername   String?

  status            UserStatus  @default(PENDING)
  avatarUrl         String?
  role              UserRole    @default(USER)

  clanId            String?
  clan              Clan?       @relation(fields: [clanId], references: [id], onDelete: SetNull)

  slots             Slot[]
  createdEvents     Event[]     @relation("EventCreator")
  auditLogs         AuditLog[]
  clanHistory       ClanHistory[]
  absences          Absence[]
  attendances       Attendance[]
  participationSnapshots ParticipationSnapshot[]
  clanChangeRequests ClanChangeRequest[]
  clanCreationRequests ClanCreationRequest[] @relation("ClanCreationRequester")
  reviewedClanCreationRequests ClanCreationRequest[] @relation("ClanCreationReviewer")
  eventInvitationsSent EventInvitation[]
  oauthAccounts     OAuthAccount[]
  gameIdentities    GameIdentity[]
  permissionOverrides UserPermissionOverride[]
  passwordResetTokens PasswordResetToken[]
  feedbackItems     FeedbackItem[] @relation("FeedbackAuthor")
  reviewedFeedbackItems FeedbackItem[] @relation("FeedbackReviewer")

  blockedUntil      DateTime?   // Auto-block expiry for NO_SHOW accumulation
  deletedAt         DateTime?

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([clanId])
  @@index([status])
  @@index([discordId])
  @@index([deletedAt])
}

model UserPermissionOverride {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String
  enabled    Boolean
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, permission])
  @@index([userId])
}

model Game {
  id                 String            @id @default(uuid())
  slug               String            @unique
  name               String
  status             GameStatus        @default(ACTIVE)
  supportsModsetHtml Boolean           @default(false)
  identityMode       GameIdentityMode  @default(NONE)
  identityLabel      String?
  sortOrder          Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  clans              Clan[]
  events             Event[]
  identities         GameIdentity[]
  clanCreationRequests ClanCreationRequest[]

  @@index([status])
  @@index([sortOrder])
}

model Clan {
  id          String   @id @default(uuid())
  name        String   @unique
  tag         String?
  description String?
  avatarUrl   String?
  avatarArchivedPath String?
  avatarArchivedAt   DateTime?
  primaryGameId String
  primaryGame   Game     @relation(fields: [primaryGameId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  users              User[]
  clanChangeRequests ClanChangeRequest[]
  clanCreationRequests ClanCreationRequest[] @relation("ClanCreationFulfilledClan")
  reservedSquads     Squad[]  @relation("ClanSquadReservation")
  eventInvitations   EventInvitation[]
  notionIntegration  ClanNotionIntegration?
  participationSnapshots ParticipationSnapshot[]
  feedbackItems      FeedbackItem[]

  @@index([name])
  @@index([deletedAt])
  @@index([primaryGameId])
}

model Event {
  id              String      @id @default(uuid())
  name            String
  description     String?
  briefing        String?     // Contenido HTML del briefing
  briefingFileUrl String?     // URL del archivo PDF del briefing
  modsetFileUrl   String?     // URL del archivo HTML del modset (Arma 3)

  gameId          String
  game            Game        @relation(fields: [gameId], references: [id])
  status          EventStatus @default(ACTIVE)
  visibility      EventVisibility @default(PRIVATE)
  
  scheduledDate   DateTime
  timezone        String      @default("UTC")
  
  creatorId       String
  creator         User        @relation("EventCreator", fields: [creatorId], references: [id])
  
  squads          Squad[]
  absences        Absence[]
  attendances     Attendance[]
  auditLogs       AuditLog[]
  invitedClans      EventInvitation[]
  participationSnapshots ParticipationSnapshot[]

  serverName        String?   // Nombre del servidor de juego
  serverIp          String?   // IP del servidor de juego
  serverPort        String?   // Puerto del servidor
  serverPassword    String?   // Contraseña del servidor
  publicShareToken  String?   @unique  // Token para link público

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  @@index([status])
  @@index([scheduledDate])
  @@index([creatorId])
  @@index([deletedAt])
  @@index([gameId])
}

model FeedbackItem {
  id          String         @id @default(uuid())
  type        FeedbackType
  status      FeedbackStatus @default(OPEN)
  title       String
  description String
  pagePath    String?

  userId      String
  user        User           @relation("FeedbackAuthor", fields: [userId], references: [id], onDelete: Cascade)
  clanId      String?
  clan        Clan?          @relation(fields: [clanId], references: [id], onDelete: SetNull)

  reviewedBy  String?
  reviewer    User?          @relation("FeedbackReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt  DateTime?
  adminNote   String?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId])
  @@index([clanId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model EventInvitation {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  clanId    String
  clan      Clan     @relation(fields: [clanId], references: [id], onDelete: Cascade)
  invitedBy String
  inviter   User     @relation(fields: [invitedBy], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, clanId])
  @@index([eventId])
  @@index([clanId])
}

model Squad {
  id          String   @id @default(uuid())
  name        String   // Ej: "Alfa", "Bravo", "Reconocimiento"
  order       Int      // Para ordenar las escuadras

  frequency        String?  // Frecuencia interna de la escuadra (ej: "42.00")
  isCommand        Boolean  @default(false) // Si es nodo de mando
  parentSquadId    String?  // ID de la escuadra padre
  parentSquad      Squad?   @relation("SquadHierarchy", fields: [parentSquadId], references: [id], onDelete: SetNull)
  childSquads      Squad[]  @relation("SquadHierarchy")
  parentFrequency  String?  // Frecuencia para comunicarse con el padre
  
  reservedForClanId String?
  reservedForClan   Clan?    @relation("ClanSquadReservation", fields: [reservedForClanId], references: [id], onDelete: SetNull)

  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  slots       Slot[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([eventId])
  @@index([reservedForClanId])
  @@index([deletedAt])
}

model Slot {
  id          String      @id @default(uuid())
  role        String      // Ej: "Fusilero", "Médico", "Líder de escuadra"
  order       Int         // Para ordenar los slots
  status      SlotStatus  @default(FREE)
  
  squadId     String
  squad       Squad       @relation(fields: [squadId], references: [id], onDelete: Cascade)
  
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  @@index([squadId])
  @@index([userId])
  @@index([deletedAt])
}

model ClanHistory {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  previousClan String?
  newClan      String?
  reason       String?
  
  changedAt    DateTime @default(now())
  
  @@index([userId])
}

model Absence {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  reason      String?
  
  createdAt   DateTime @default(now())
  
  @@unique([userId, eventId])
  @@index([eventId])
}

model Attendance {
  id        String           @id @default(uuid())

  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  eventId   String
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)

  slotId    String?          // null para check-ins manuales (walk-ins)
  status    AttendanceStatus
  note      String?

  markedBy  String           // userId de quien marco la asistencia

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, eventId])
  @@index([eventId])
  @@index([userId])
}

model ClanChangeRequest {
  id              String   @id @default(uuid())
  
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  currentClanId   String?
  targetClanId    String
  targetClan      Clan     @relation(fields: [targetClanId], references: [id], onDelete: Cascade)
  
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reason          String?
  
  reviewedBy      String?
  reviewedAt      DateTime?
  
  createdAt       DateTime @default(now())
  
  @@index([userId])
  @@index([targetClanId])
  @@index([status])
}

model ClanCreationRequest {
  id                String                    @id @default(uuid())
  userId            String
  user              User                      @relation("ClanCreationRequester", fields: [userId], references: [id], onDelete: Cascade)
  requestedName     String
  requestedTag      String?
  requestedDescription String?
  primaryGameId     String
  primaryGame       Game                      @relation(fields: [primaryGameId], references: [id], onDelete: Restrict)
  status            ClanCreationRequestStatus @default(PENDING)
  reviewedBy        String?
  reviewer          User?                     @relation("ClanCreationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewNote        String?
  reviewedAt        DateTime?
  createdClanId     String?
  createdClan       Clan?                     @relation("ClanCreationFulfilledClan", fields: [createdClanId], references: [id], onDelete: SetNull)
  fulfilledAt       DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([primaryGameId])
}

model AuditLog {
  id          String   @id @default(uuid())

  action      String   // Ej: "USER_VALIDATED", "SLOT_ASSIGNED", "EVENT_CREATED"
  entity      String   // Ej: "User", "Event", "Slot"
  entityId    String

  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  eventId     String?
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)

  details     String?  // JSON con detalles adicionales

  createdAt   DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}

model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider          String   // "discord"
  providerAccountId String   // Discord user ID

  accessToken       String?  @db.Text
  refreshToken      String?  @db.Text
  tokenType         String?  // "Bearer"
  scope             String?  // "identify email guilds"
  expiresAt         Int?     // Unix timestamp (epoch seconds)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model GameIdentity {
  id              String                   @id @default(uuid())
  userId          String
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId          String
  game            Game                     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  providerKind    GameIdentityProviderKind
  value           String
  normalizedValue String?
  status          GameIdentityStatus       @default(PENDING)
  verifiedBy      String?
  verifiedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([userId])
  @@index([gameId])
  @@index([status])
  @@unique([gameId, providerKind, normalizedValue])
  @@unique([userId, gameId])
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model ClanNotionIntegration {
  id                       String         @id @default(uuid())
  clanId                   String         @unique
  clan                     Clan           @relation(fields: [clanId], references: [id], onDelete: Cascade)
  enabled                  Boolean        @default(false)
  notionToken              String?        @db.Text
  parentPageId             String?
  missionsDatabaseId       String?
  participationsDatabaseId String?
  syncMode                 NotionSyncMode @default(MANUAL)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@index([enabled])
}

model ParticipationSnapshot {
  id                String           @id @default(uuid())
  clanId            String
  clan              Clan             @relation(fields: [clanId], references: [id], onDelete: Cascade)
  eventId           String
  event             Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userNickname      String
  eventName         String
  eventDate         DateTime
  attendanceStatus  AttendanceStatus
  slotRole          String?
  squadName         String?
  exportedToNotion  Boolean          @default(false)
  exportedToNotionAt DateTime?
  notionLastSyncAt  DateTime?
  notionLastError   String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([clanId, eventId, userId])
  @@index([clanId])
  @@index([eventId])
  @@index([userId])
  @@index([eventDate])
  @@index([exportedToNotion])
}
